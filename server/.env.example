# ==============================================================================
# AURELIA UA Backend Environment Configuration
# Copy this file to server/.env for local overrides (never commit .env to git)
# ==============================================================================

# Server Network Port
PORT=5000

# PostgreSQL Connection String (optional — if omitted, automatically uses local JSON database fallback)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# JWT Secret for Signing and Verifying Tokens
JWT_SECRET=replace_with_strong_secret

# Default Administrator Account (auto-granted ADMIN role upon registration/login)
ADMIN_EMAIL=admin@aurelia.ua

# Allowed CORS Origins (comma-separated or * for development)
CORS_ORIGIN=*
